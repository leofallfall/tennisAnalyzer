# Copy to .env to override defaults. scripts/dev.sh loads .env automatically; when running
# processes by hand, export the variables in your shell. Values below are the defaults.

# Where uploaded videos, artifacts and the SQLite DB are stored
TPA_STORAGE_DIR=./storage
# Leave empty for SQLite in TPA_STORAGE_DIR; e.g. postgresql+psycopg://user:pass@host/db later
TPA_DATABASE_URL=
TPA_MAX_UPLOAD_MB=4096
TPA_API_HOST=127.0.0.1
TPA_API_PORT=8000
TPA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Run pose estimation on every N-th frame (1 = every frame)
TPA_POSE_STRIDE=1
# Directory with MediaPipe .task models (default: ./models)
TPA_MODELS_DIR=
# Optional explicit FFmpeg binaries
FFMPEG_PATH=
FFPROBE_PATH=
# AI analysis adapter: claude_code (interactive, no API key) | anthropic_api (not implemented)
TPA_AI_ADAPTER=claude_code
# Language of AI-written text
TPA_AI_LANGUAGE=it
# Quieten MediaPipe native logging
GLOG_minloglevel=2

# Web (Vite): only needed if the API is not proxied through the dev server
VITE_API_BASE_URL=
# Vite dev-server proxy target
TPA_API_URL=http://127.0.0.1:8000
