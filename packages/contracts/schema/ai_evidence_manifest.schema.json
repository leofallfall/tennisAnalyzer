{
  "$defs": {
    "DataStatus": {
      "enum": [
        "available",
        "not_implemented",
        "empty"
      ],
      "title": "DataStatus",
      "type": "string"
    },
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "frame_index": {
          "title": "Frame Index",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "Relative to the pack directory",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ImageRole"
        },
        "skeleton_drawn": {
          "title": "Skeleton Drawn",
          "type": "boolean"
        },
        "stroke_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Id"
        },
        "timestamp_s": {
          "title": "Timestamp S",
          "type": "number"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "video_id",
        "frame_index",
        "timestamp_s",
        "role",
        "skeleton_drawn",
        "width",
        "height"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "ImageRole": {
      "enum": [
        "overview",
        "preparation",
        "contact",
        "follow_through",
        "sequence"
      ],
      "title": "ImageRole",
      "type": "string"
    },
    "MotivatingIssue": {
      "additionalProperties": false,
      "description": "The session-level issue that led the user to request a single-stroke analysis.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_ai_analysis_id": {
          "title": "Source Ai Analysis Id",
          "type": "string"
        }
      },
      "required": [
        "source_ai_analysis_id",
        "issue_id",
        "name",
        "description"
      ],
      "title": "MotivatingIssue",
      "type": "object"
    },
    "PackFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "PackFile",
      "type": "object"
    },
    "PackKind": {
      "enum": [
        "session",
        "single_stroke"
      ],
      "title": "PackKind",
      "type": "string"
    },
    "SingleStrokeTarget": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "motivating_issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/MotivatingIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/StrokeSource"
        },
        "stroke_id": {
          "title": "Stroke Id",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "stroke_id",
        "source",
        "interval"
      ],
      "title": "SingleStrokeTarget",
      "type": "object"
    },
    "StrokeSource": {
      "enum": [
        "detected",
        "user_interval"
      ],
      "title": "StrokeSource",
      "type": "string"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "description": "Closed interval in seconds on the *source video* timeline.",
      "properties": {
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s"
      ],
      "title": "TimeInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_status": {
      "additionalProperties": {
        "$ref": "#/$defs/DataStatus"
      },
      "title": "Data Status",
      "type": "object"
    },
    "files": {
      "description": "Integrity list: every file except manifest",
      "items": {
        "$ref": "#/$defs/PackFile"
      },
      "title": "Files",
      "type": "array"
    },
    "generator": {
      "title": "Generator",
      "type": "string"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ImageRef"
      },
      "title": "Images",
      "type": "array"
    },
    "instructions_version": {
      "default": "ai-instructions/1.0",
      "title": "Instructions Version",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/PackKind"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "pack_id": {
      "title": "Pack Id",
      "type": "string"
    },
    "pack_schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Pack Schema Version",
      "type": "string"
    },
    "privacy": {
      "default": "Contains no video, no full pose sequence, no credentials and no absolute paths.",
      "title": "Privacy",
      "type": "string"
    },
    "result_file": {
      "title": "Result File",
      "type": "string"
    },
    "result_schema_version": {
      "title": "Result Schema Version",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/SingleStrokeTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "pack_id",
    "kind",
    "analysis_id",
    "created_at",
    "generator",
    "result_schema_version",
    "result_file",
    "language",
    "data_status",
    "images",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
