        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "proxy_frame": {
          "minimum": 0,
          "title": "Proxy Frame",
          "type": "integer"
        },
        "quality_window": {
          "$ref": "#/$defs/QualityWindow"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "speed": {
          "$ref": "#/$defs/Speed"
        },
        "status": {
          "$ref": "#/$defs/PeakStatus"
        },
        "t_s": {
          "description": "Time on the file's time_basis",
          "title": "T S",
          "type": "number"
        },
        "wrist": {
          "$ref": "#/$defs/Wrist"
        }
      },
      "required": [
        "id",
        "wrist",
        "proxy_frame",
        "t_s",
        "speed",
        "provenance",
        "quality_window",
        "status"
      ],
      "title": "WristPeak",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``strokes.json`` 1.x (see module docstring and docs/M2_3_EVENTS.md).",
  "properties": {
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "1.1, optional; null = not recorded (every 1.0 file)"
