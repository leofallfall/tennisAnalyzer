      "title": "Params",
      "type": "object"
    },
    "params_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Params Sha256",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
