      "title": "Created At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/CandidateEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/Inputs"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
