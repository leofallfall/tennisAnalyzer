  "required": [
    "schema",
    "schema_version",
    "created_at",
    "producer",
    "inputs",
    "time_basis",
    "params",
    "params_sha256",
    "rules",
    "wrist_peaks",
    "events"
  ],
  "title": "StrokesFile",
  "type": "object"
}
