        "id": {
          "pattern": "^[a-z][A-Za-z0-9_.-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "prominence": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeakProminence"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
